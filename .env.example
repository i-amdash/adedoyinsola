PORT=3001
HOST=127.0.0.1
# Run npm run admin:setup to create ADMIN_PASSWORD_HASH securely.
ADMIN_PASSWORD_HASH=

# Server-side Supabase credentials. Never prefix the secret with VITE_ or NEXT_PUBLIC_.
SUPABASE_URL=https://atgcmosflopbkmfkqrxs.supabase.co
SUPABASE_SECRET_KEY=
# Publishable key is optional: all database access goes through the Express API.
SUPABASE_PUBLISHABLE_KEY=
# Cloud mode is required on Vercel; set local only for an isolated offline preview.
DATA_BACKEND=supabase

# A standalone local server can use local files instead of Supabase:
# DATA_BACKEND=local
# DATA_DIR=/absolute/path/to/persistent/data
# TRUST_PROXY=1 (only behind one trusted reverse proxy)
