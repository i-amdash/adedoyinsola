export type Option = { id: string; label: string; price: number; weeks?: number; monthly?: number; multiplier?: number; speed?: number; enabled?: boolean };
export type Question = {
  id: string;
  label: string;
  help?: string;
  type: "single" | "multi" | "count";
  options?: Option[];
  min?: number;
  max?: number;
  included?: number;
  unitPrice?: number;
  unitWeeks?: number;
  unit?: string;
};
export type Step = { id: string; title: string; questions: Question[] };
export type Product = { id: string; kind: "web" | "mobile"; name: string; tagline: string; base: number; weeks: [number, number]; includes: string[]; enabled: boolean; steps: Step[] };
export type Catalog = { usdRate: number; spread: number; products: Product[]; finishing: Step[] };
export type Answers = Record<string, string | string[] | number>;
export type Estimate = { product: string; total: number; low: number; high: number; weeks: [number, number]; monthly: number; lines: { label: string; amount: number }[]; answers: Answers };
export type Currency = "NGN" | "USD";
export const defaultBuilder: Catalog;
export const suggested: Record<string, Partial<Answers>>;
export function stepsFor(catalog: Catalog, productId: string): Step[];
export function questionsFor(catalog: Catalog, productId: string): Question[];
export function defaultAnswers(catalog: Catalog, productId: string): Answers;
export function cleanAnswers(catalog: Catalog, productId: string, raw: unknown): Answers;
export function estimate(catalog: Catalog, productId: string, answers: unknown): Estimate | null;
export function formatMoney(naira: number, currency?: Currency, usdRate?: number): string;
export function describe(catalog: Catalog, productId: string, answers: Answers): [string, string][];
